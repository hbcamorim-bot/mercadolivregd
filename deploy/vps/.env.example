# Banco exclusivo desta aplicacao. Use apenas letras e numeros na senha para
# que a mesma senha funcione sem codificacao adicional dentro de DATABASE_URL.
POSTGRES_USER=mercadolivregd
POSTGRES_PASSWORD=<generate-a-long-random-alphanumeric-value>
POSTGRES_DB=mercadolivregd
DATABASE_URL=postgresql://mercadolivregd:<same-postgres-password>@postgres:5432/mercadolivregd?schema=public

# Defina uma senha administrativa forte e um segredo aleatorio com pelo menos
# 32 caracteres. Estes valores ficam somente em /opt/mercadolivregd/deploy/vps/.env.
ADMIN_PASSWORD=<set-a-strong-admin-password>
AUTH_SECRET=<generate-at-least-32-random-characters>

# Valores publicos incorporados ao bundle durante o build.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
NEXT_PUBLIC_EMAIL=contato@mercadolivregd.com
NEXT_PUBLIC_SITE_URL=https://mercadolivregd.187-127-45-24.sslip.io
